# ===== 部署模式 =====
# vless-reality  : 默认，免证书免域名，最适合 Doprax/Render 等免费 PaaS（每次重新部署=换新IP）
# vless-ws-tls   : 自有 VPS + 真实域名 + TLS 证书（证书挂到 CERT_DIR）
# vmess-ws-tls   : 同上，但用 VMess 协议
MODE=vless-reality

# 监听端口（Doprax/Render 会自动用平台环境变量 PORT 覆盖此项）
PORT=8080

# 留空则每次启动自动生成新 UUID；要固定就填一个（用 `xray uuid` 生成）
UUID=

# ===== vless-reality 模式专用 =====
REALITY_SNI=www.apple.com        # 伪装的境外站点，随便填真实存在的 HTTPS 站
REALITY_DEST=www.apple.com:443   # 上述站点的真实地址:端口
SHORT_ID=

# ===== *-ws-tls 模式专用 =====
DOMAIN=your.domain.com
WS_PATH=/ray
CERT_DIR=/certs
